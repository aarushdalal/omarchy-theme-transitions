import re
import shutil
import subprocess
import sys
from pathlib import Path
try:
    import tomllib
except ImportError:
    import tomli as tomllib

HOME = Path.home()
OMARCHY_STATE = HOME / ".local/state/omarchy/current"
CAELESTIA_STATE = HOME / ".local/state/caelestia"
HYPR_SCHEME_DIR = HOME / ".config/hypr/scheme"


def hex_to_rgb(hex_str: str) -> tuple[int, int, int]:
    s = hex_str.lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    if len(s) >= 6:
        return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
    return (0, 0, 0)


def hex_to_ansi(c: str, *i: int) -> str:
    c = c.lstrip("#")
    if len(c) < 6:
        c = c.ljust(6, "0")
    return f"\x1b]{';'.join(map(str, i))};rgb:{c[0:2]}/{c[2:4]}/{c[4:6]}\x1b\\"


def resolve_wallpaper_path(arg_path: str | None) -> Path | None:
    if arg_path:
        p = Path(arg_path).expanduser().resolve()
        if p.is_file():
            return p

    link = OMARCHY_STATE / "background"
    if link.is_symlink() or link.is_file():
        p = link.resolve()
        if p.is_file():
            return p

    c_wall = CAELESTIA_STATE / "wallpaper/path.txt"
    if c_wall.is_file():
        p = Path(c_wall.read_text().strip()).resolve()
        if p.is_file():
            return p

    return None


def extract_frame_if_video(path: Path) -> Path:
    video_exts = {".mp4", ".mkv", ".webm", ".mov", ".avi"}
    if path.suffix.lower() in video_exts:
        thumb = Path("/tmp/omarchy-live-wallpaper-thumb.jpg")
        if shutil.which("ffmpeg"):
            subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-ss",
                    "00:00:01",
                    "-i",
                    str(path),
                    "-vframes",
                    "1",
                    "-f",
                    "image2",
                    str(thumb),
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if thumb.is_file():
                return thumb
    return path


def to_vibrant_dark_shade(hex_code: str, target_l: float = 0.46, min_s: float = 0.55) -> str:
    """Derives a rich, vibrant darker shade from any color.
    Ensures it is clearly visible and colorful on black screens (L ~ 44-48%, S >= 55%),
    never washed out pastel (L > 70%) and never near-black (L < 30%).
    """
    import colorsys
    s = hex_code.lstrip("#")
    if len(s) < 6:
        return hex_code
    r, g, b = [int(s[i:i+2], 16) / 255.0 for i in (0, 2, 4)]
    h, l, s_val = colorsys.rgb_to_hls(r, g, b)
    new_s = max(min_s, min(0.85, s_val * 1.35))
    nr, ng, nb = colorsys.hls_to_rgb(h, target_l, new_s)
    return f"{int(nr * 255):02x}{int(ng * 255):02x}{int(nb * 255):02x}"


def wallpaper_theme_directories(slug):
    # DaemonOS-only imports retain authored palettes in the shared media library.
    return [HOME / f".config/omarchy/themes/{slug}",
            HOME / f".local/share/omarchy/wallpapers/library/{slug}",
            Path(f"/usr/share/omarchy/themes/{slug}")]


def load_theme_colors_if_available(wall_path: Path):
    """If the wallpaper belongs to an Omarchy theme that has colors.toml, load the authored palette."""
    real_p = wall_path.resolve()
    candidates = []

    # 1. Check directory hierarchy and filename of the wallpaper first
    if real_p.parent.name == "backgrounds":
        p_parent = real_p.parent.parent.name
        if p_parent not in {"theme", "current", "."} and p_parent not in candidates:
            candidates.append(p_parent)
    m = re.match(r"^([a-z0-9-]+)-[a-f0-9]{12}-", wall_path.name)
    if m and m.group(1) not in candidates:
        candidates.append(m.group(1))

    # 2. Check active theme state from files
    for state_file in [OMARCHY_STATE / "theme.name", CAELESTIA_STATE / "omarchy-theme.name"]:
        if state_file.is_file():
            try:
                t_name = state_file.read_text().strip()
                if t_name and t_name not in candidates:
                    candidates.append(t_name)
            except Exception:
                pass

    if real_p.parent.name not in {"backgrounds", "theme", "current"} and real_p.parent.name not in candidates:
        candidates.append(real_p.parent.name)
    if real_p.stem not in candidates:
        candidates.append(real_p.stem)

    for slug in candidates:
        slug_clean = slug.lower().replace(" ", "-")
        theme_dirs = wallpaper_theme_directories(slug_clean)
        for td in theme_dirs:
            toml_file = td / "colors.toml"
