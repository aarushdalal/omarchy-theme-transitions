            "secondary_paletteKeyColor": "b0b0bc",
            "tertiary_paletteKeyColor": "9494a2",
            "neutral_paletteKeyColor": "121214",
            "neutral_variant_paletteKeyColor": "26262a",
            "term0": "18181c",
            "term1": "c07078",
