            "primary": "dcdce8",  # High-contrast luminous frost silver for active window borders!
            "primaryDim": "f0f0fa",
            "onPrimary": "181820",
            "primaryContainer": "34343a",
            "onPrimaryContainer": "eaeaf4",
            "secondary": "b0b0bc",
            "secondaryDim": "c8c8d4",
            "onSecondary": "181820",
            "secondaryContainer": "28282e",
            "onSecondaryContainer": "d8d8e4",
            "tertiary": "9494a2",
