#!/usr/bin/env python3
"""
omarchy-wallpaper-theme-sync
Unified wallpaper-adaptive theming engine for DaemonOS and Omarchy.
Extracts Material You and ANSI palettes from the active wallpaper and
synchronizes them to Foot terminal, web browsers (Brave/Chrome), Hyprland,
GTK 3/4, Caelestia shell, and IDEs (Antigravity/VS Code).
"""

import fcntl
