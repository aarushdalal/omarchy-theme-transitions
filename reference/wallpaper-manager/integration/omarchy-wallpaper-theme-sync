def extract_colors(wall_path: Path):
    # 0. Check if this wallpaper belongs to a theme with an authored colors.toml
    authored = load_theme_colors_if_available(wall_path)
    if authored:
        mode, c, slug, extra = authored
        print(f"[wallpaper-sync] Using authored theme palette from '{slug}' colors.toml (accent=#{c['accent']}, red=#{c['red']}, green=#{c['green']})")
        return mode, c, slug, extra

    from PIL import Image

    # 1. Analyze Chroma & Luminance with PIL to detect monochromaticity
    is_mono = False
    try:
        with Image.open(wall_path) as img:
            thumb = img.convert("RGB")
            thumb.thumbnail((48, 48))
            try:
                pixels = list(thumb.get_flattened_data())
            except AttributeError:
                pixels = list(thumb.getdata())
            chromas = [max(r, g, b) - min(r, g, b) for r, g, b in pixels]
            max_chroma = max(chromas) if chromas else 0
            sorted_c = sorted(chromas)
            p95_chroma = sorted_c[int(len(sorted_c) * 0.95)] if sorted_c else 0
            # ONLY truly grayscale/monochromatic images have near-zero max chroma and p95 chroma
            if max_chroma < 18 and p95_chroma < 10:
                is_mono = True
    except Exception as e:
        print(f"[wallpaper-sync] Image analysis warning: {e}", file=sys.stderr)

    # 2. Monochromatic Contrast-Safe Palette (Prevent Caelestia recursion crash & invisible borders)
    if is_mono:
        print(f"[wallpaper-sync] Detected monochromatic/grayscale wallpaper ({wall_path.name}). Applying contrast-safe dark palette.")
        c = {
            "background": "121214",
            "onBackground": "f4f4f8",
            "surface": "121214",
            "surfaceDim": "121214",
            "surfaceBright": "303036",
            "surfaceContainerLowest": "0d0d0f",
            "surfaceContainerLow": "161618",
            "surfaceContainer": "1c1c20",
            "surfaceContainerHigh": "242428",
            "surfaceContainerHighest": "2c2c32",
            "surfaceVariant": "26262a",
