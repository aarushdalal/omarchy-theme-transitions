            "teal": "80a8a8",
            "mauve": "b090b0",
            "accent": "dcdce8",
            "dark_accent": "242428",
        }
        return "dark", c

    # 3. Chromatic Wallpapers: Force Dark Mode & Ensure Vibrant Dark UI Shades with Light Text
    try:
        from caelestia.utils.wallpaper import get_colours_for_wall

        # no_smart=True forces preservation of dark mode without recursive scoring crash!
        result = get_colours_for_wall(wall_path, True)
        colors = result["colours"]

        def lum(hex_code):
            r, g, b = hex_to_rgb(hex_code)
            return 0.299 * r + 0.587 * g + 0.114 * b

        # Enforce dark surface for UI (surfaces must be dark, mood-toned)
        if lum(colors.get("surface", "000000")) > 45:
            dim = colors.get("surfaceDim")
            lowest = colors.get("surfaceContainerLowest")
            if dim and lum(dim) <= 45:
                colors["surface"] = dim
            elif lowest and lum(lowest) <= 45:
                colors["surface"] = lowest
            else:
                sr, sg, sb = hex_to_rgb(colors.get("surface", "151315"))
                colors["surface"] = f"{max(8, sr // 3):02x}{max(8, sg // 3):02x}{max(8, sb // 3):02x}"

        # Enforce dark surfaceContainer
        if lum(colors.get("surfaceContainer", "000000")) > 65:
            cr, cg, cb = hex_to_rgb(colors.get("surface", "151315"))
            colors["surfaceContainer"] = f"{min(255, cr + 14):02x}{min(255, cg + 14):02x}{min(255, cb + 14):02x}"

        # Select authentic vibrant dark shades of the palette (visible dark purple, not near-black)
        seed_primary = (
            colors.get("primaryPaletteKeyColor")
            or colors.get("kvisited")
            or colors.get("primary")
            or "a866c5"
        )
        seed_secondary = (
            colors.get("klink")
            or colors.get("secondaryPaletteKeyColor")
            or colors.get("secondary")
            or "9778ca"
        )
        seed_tertiary = (
            colors.get("tertiaryPaletteKeyColor")
            or colors.get("tertiaryContainer")
            or colors.get("tertiary")
            or "be8792"
        )

        rich_primary = to_vibrant_dark_shade(seed_primary, target_l=0.46, min_s=0.55)
        rich_secondary = to_vibrant_dark_shade(seed_secondary, target_l=0.46, min_s=0.55)
        rich_tertiary = to_vibrant_dark_shade(seed_tertiary, target_l=0.46, min_s=0.50)
        deep_dark_accent = to_vibrant_dark_shade(seed_primary, target_l=0.24, min_s=0.45)

        colors["primary"] = rich_primary
        colors["secondary"] = rich_secondary
        colors["tertiary"] = rich_tertiary
        colors["accent"] = rich_primary
        colors["dark_accent"] = deep_dark_accent

        colors["primaryContainer"] = to_vibrant_dark_shade(seed_primary, target_l=0.33, min_s=0.48)
        colors["secondaryContainer"] = to_vibrant_dark_shade(seed_secondary, target_l=0.33, min_s=0.48)
        colors["tertiaryContainer"] = rich_tertiary

        # Enforce high-contrast light text for dark/black screens (AAA readability)
        colors["onSurface"] = "f4f4f8"
        colors["onSurfaceVariant"] = "cec3cc"
        colors["onBackground"] = "f4f4f8"
        colors["inverseSurface"] = "f4f4f8"
        colors["onPrimary"] = "ffffff"
        colors["onSecondary"] = "ffffff"
        colors["onTertiary"] = "ffffff"
        colors["onPrimaryContainer"] = "f4f4f8"
        colors["onSecondaryContainer"] = "f4f4f8"
        colors["onTertiaryContainer"] = "f4f4f8"
        colors["outline"] = "a49aa6"
        colors["outlineVariant"] = "5a525d"

        return "dark", colors
    except Exception as e:
        print(f"[wallpaper-sync] Caelestia extractor warning: {e}", file=sys.stderr)

    # Fallback to pure PIL extraction
    try:
        with Image.open(wall_path) as img:
            img = img.convert("RGB")
            img.thumbnail((64, 64))
            colors = img.getcolors(maxcolors=4096)
            if colors:
                colors.sort(reverse=True, key=lambda x: x[0])
                r, g, b = colors[0][1]
            else:
                r, g, b = (20, 24, 28)
            sr, sg, sb = min(32, r // 3), min(32, g // 3), min(32, b // 3)
            surface = f"{sr:02x}{sg:02x}{sb:02x}"
            pr, pg, pb = min(255, max(140, r + 40)), min(255, max(140, g + 40)), min(255, max(140, b + 40))
            primary = f"{pr:02x}{pg:02x}{pb:02x}"
            c = {
                "surface": surface,
                "surfaceDim": surface,
                "surfaceContainer": f"{min(255, sr + 10):02x}{min(255, sg + 10):02x}{min(255, sb + 10):02x}",
                "primary": primary,
                "onSurface": "f0f0f4",
                "term0": "18181c",
                "term1": "e06c75",
                "term2": "98c379",
                "term3": "e5c07b",
                "term4": "61afef",
                "term5": "c678dd",
                "term6": "56b6c2",
                "term7": "abb2bf",
