#!/usr/bin/env bash

# omarchy:summary=Cycle to the next background for the current theme
# omarchy:examples=omarchy theme bg next

set -euo pipefail

THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
THEME_BACKGROUNDS_PATH="$HOME/.local/state/omarchy/current/theme/backgrounds"
USER_BACKGROUNDS_PATH="$HOME/.config/omarchy/backgrounds/$THEME_NAME"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

CURRENT_BACKGROUND=""
if [[ -L $CURRENT_BACKGROUND_LINK ]]; then
  CURRENT_BACKGROUND=$(readlink -f "$CURRENT_BACKGROUND_LINK" 2>/dev/null || readlink "$CURRENT_BACKGROUND_LINK")
fi

mapfile -d '' -t BACKGROUNDS < <(
  find -L "$USER_BACKGROUNDS_PATH" "$THEME_BACKGROUNDS_PATH" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) \
    -print0 2>/dev/null | sort -z
)

# If current theme has only 0 or 1 background, expand candidate pool to theme group and user wallpapers
if (( ${#BACKGROUNDS[@]} <= 1 )); then
  mapfile -d '' -t GROUP_BACKGROUNDS < <(
    python3 -c "
import sys
from pathlib import Path
h = Path.home()
sys.path.insert(0, str(h / 'Projects/wallpaper-importer'))
try:
    import wallpaper_groups as grouping
    data = grouping.load()
    theme = '$THEME_NAME'
    grp = grouping.group_for(theme, data=data) if theme else ''
    members = sorted([s for s, g in data.get('assignments', {}).items() if g == grp]) if grp else []
except Exception:
    members = []

EXTS = {'.jpg', '.jpeg', '.png', '.webp', '.bmp', '.gif'}
seen = set()

# Theme group wallpapers
for s in members:
    p = h / '.config/omarchy/themes' / s / 'backgrounds'
    if p.is_dir():
        for f in sorted(p.iterdir()):
            if f.is_file() and f.suffix.lower() in EXTS:
                real = str(f.resolve())
                if real not in seen:
                    seen.add(real)
                    sys.stdout.buffer.write(real.encode('utf-8') + b'\0')

# Extra user wallpapers and backgrounds
for extra in [h / 'Wallpapers', h / '.config/omarchy/backgrounds']:
    if extra.is_dir():
        for f in sorted(extra.glob('**/*')):
            if f.is_file() and f.suffix.lower() in EXTS:
                real = str(f.resolve())
                if real not in seen:
                    seen.add(real)
                    sys.stdout.buffer.write(real.encode('utf-8') + b'\0')
" 2>/dev/null || true
  )
  if (( ${#GROUP_BACKGROUNDS[@]} > 1 )); then
    BACKGROUNDS=("${GROUP_BACKGROUNDS[@]}")
  fi
fi

TOTAL=${#BACKGROUNDS[@]}

if (( TOTAL == 0 )); then
  omarchy-notification-send "No background was found for theme" -t 2000
  exit 0
fi

# Find current background index
INDEX=-1
for i in "${!BACKGROUNDS[@]}"; do
  bg_real=$(readlink -f "${BACKGROUNDS[$i]}" 2>/dev/null || echo "${BACKGROUNDS[$i]}")
  if [[ "$bg_real" == "$CURRENT_BACKGROUND" || "${BACKGROUNDS[$i]}" == "$CURRENT_BACKGROUND" ]]; then
    INDEX=$i
    break
  fi
done

# Get next background (wrap around)
if (( INDEX == -1 )); then
  NEW_BACKGROUND="${BACKGROUNDS[0]}"
else
  NEXT_INDEX=$(((INDEX + 1) % TOTAL))
  NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
fi

omarchy-theme-bg-set "$NEW_BACKGROUND"
